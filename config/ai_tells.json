  "soft_patterns": {
    "worth_gerund": {
      "patterns": [
        "\\bworth \\w+ing\\b"
      ],
      "allowance": 1
    },
    "roundup_seam": {
      "patterns": [
        "\\bfrom the (?:news )?roundup\\b",
        "\\bfrom today's feed\\b",
        "\\bfrom earlier in the (?:show|episode)\\b"
      ],
      "allowance": 0
    },
    "thats_closer": {
      "patterns": [
        "\\bThat's [^.!?\\n]{2,60}[.!?][\"']?\\s*$"
      ],
      "allowance": 2,
      "multiline": true
    },
    "false_ranges": {
      "patterns": [
        "\\beverything from \\w+[^.!?]{0,40} to \\b",
        "\\banything from \\w+[^.!?]{0,40} to \\b"
      ],
      "allowance": 0
    },
    "meta_linguistic": {
      "patterns": [
        "\\b(?:is|are) (?:carrying|doing) a lot of (?:weight|work)\\b",
        "\\bcarrying (?:a lot of |real |serious )?weight (?:in|there)\\b"
      ],
      "allowance": 0
    }
  },
