{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cariboo-feedback",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",

  // The review page calls this from the browser, so it needs a public URL.
  // workers.dev is enough: the endpoint is not a secret, the passphrase is.
  "workers_dev": true,

  "observability": { "enabled": true }
}
