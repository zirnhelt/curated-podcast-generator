.env

# Virtual environment
venv/

#test files
*test*
# ...but never the CI workflow. An ignored workflow file is silently never
# pushed, which is the failure mode this job exists to prevent.
!.github/workflows/tests.yml

# Backup files from refactoring
*.pre-config

# Python cache
__pycache__/
*.pyc

# Test scripts (keep local only)
check_config_status.sh
run_full_tests.sh

# Audio files — large binaries deployed via GitHub Pages and R2, not tracked in git
podcasts/*.mp3
podcasts/bespoke/*.mp3

# Episode videos — rendered for YouTube upload (or CI artifact review), never committed
podcasts/*.mp4
